# ============================================================================
# AYNI · Variables de entorno del backend
# Todas se leen en un solo lugar: backend/app/core/config.py (objeto `settings`).
# Copie este archivo como backend/.env y complete los valores.
# ============================================================================

# --- Base de datos: PostgreSQL en Supabase (Session pooler, puerto 5432) ---
# Supabase → Project Settings → Database → Connection string → "Session pooler".
# IMPORTANTE: si la contraseña contiene caracteres especiales debe ir URL-encodeada:
#   @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   % → %25   & → %26   espacio → %20
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Alternativa (solo si DATABASE_URL está vacía): conexión por partes.
# Aquí la contraseña va tal cual; config.py la URL-encodea automáticamente.
# DB_SERVER=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require

# --- Pool de conexiones (psycopg_pool) ---
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=5

# --- Supabase (opcional: solo si se usan REST/Storage/Auth de Supabase) ---
# Supabase → Project Settings → API. La SERVICE_ROLE_KEY nunca va al frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS (separado por comas; http://localhost:4200 se agrega siempre) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- JWT ---
JWT_SECRET=ayni_super_secret_jwt_key_2026_cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Recetario externo ---
API_NINJAS_KEY=tu_api_key_de_api_ninjas
# Opcional: Google Cloud Translation API (consola de Google Cloud → APIs → Cloud Translation API).
# Sin clave se usan traductores gratuitos (Google sin clave → MyMemory).
GOOGLE_TRANSLATE_API_KEY=
